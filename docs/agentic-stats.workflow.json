    {
      "dot": "cyan",
      "title": "Know what is counted",
      "items": [
        "Main totals cover managed task calls; ordinary chats are excluded.",
        "Jev usage is separate. Unknown billing is flagged, never free."
      ]
    },
    {
      "dot": "amber",
      "title": "Separate time from waiting",
      "items": [
        "Elapsed time includes approval and idle gaps.",
        "Execution sums task-run invocations; incomplete timing is n/a."
      ]
    },
    {
      "dot": "violet",
      "title": "Savings remain unproven",
      "items": [
        "No ordinary-workflow baseline has been collected yet.",
        "Historical trials exclude qualification; compare only reconciled data."
