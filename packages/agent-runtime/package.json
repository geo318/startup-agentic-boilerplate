{
  "name": "@startup-agentic/agent-runtime",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "test": "node --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit -p .",
    "format": "biome format --write ../..",
    "format:check": "biome format ../..",
    "lint": "biome lint ../.."
  },
  "bin": {
    "agentic": "src/cli/main.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@types/node": "^22.20.4",
    "ts-compiler-api": "npm:typescript@^6.0.3",
    "typescript": "^7.0.2"
  }
}
