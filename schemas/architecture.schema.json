{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ArchitectureBoundaries",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "layers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "tsconfig": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "include",
          "mayImport"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,40}$"
          },
          "include": {
            "type": "array",
            "minItems": 1,
            "maxItems": 50,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "mayImport": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "string"
            }
          },
          "forbidPackages": {
            "type": "array",
            "maxItems": 100,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          }
        }
      }
    },
    "minFiles": {
      "type": "integer",
      "minimum": 1
    },
    "ignoreTypeOnly": {
      "type": "boolean"
    },
    "allowUnclassified": {
      "type": "boolean"
    },
    "allowDynamic": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "cover": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    }
  }
}
