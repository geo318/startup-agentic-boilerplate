{
  "permissions": {
    "deny": ["AskUserQuestion"],
    "allow": [
      "Bash({{CMD_LINT}})",
      "Bash({{CMD_LINT}} *)",
      "Bash({{CMD_TYPECHECK}})",
      "Bash({{CMD_TYPECHECK}} *)",
      "Bash({{CMD_TEST}})",
      "Bash({{CMD_TEST}} *)",
      "Bash({{RUNTIME}} scripts/checks/docs-check.mjs)",
      "Bash({{RUNTIME}} scripts/checks/docs-check.mjs *)",
      "Bash({{RUNTIME}} scripts/git/conventions.mjs *)",
      "Bash({{RUNTIME}} scripts/skills/index.mjs)",
      "Bash({{RUNTIME}} scripts/skills/index.mjs *)",
      "Bash({{RUNTIME}} scripts/session/cli.mjs *)",
{{#if TYPESCRIPT}}
{{#unless LEAN}}
      "Bash({{CMD_FALLOW}})",
      "Bash(npx fallow *)",
      "Bash(bunx fallow *)",
{{/unless}}
{{/if}}
      "Bash(npx skills find *)",
      "Bash(npx skills add *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git fetch *)"
    ]
  },
  "hooks": {
    "SessionStart": [{ "hooks": [{ "type": "command", "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude" }] }],
    "UserPromptSubmit": [{ "hooks": [{ "type": "command", "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude" }] }],
    "PreToolUse": [{ "matcher": "Bash|Edit|Write", "hooks": [{ "type": "command", "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude" }] }],
    "PostToolUse": [{ "hooks": [{ "type": "command", "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude" }] }],
    "SessionEnd": [{ "hooks": [{ "type": "command", "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude", "timeout": 3 }] }],
    "StopFailure": [{ "hooks": [{ "type": "command", "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude", "timeout": 3 }] }],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{RUNTIME}} \"$CLAUDE_PROJECT_DIR/scripts/session/hooks.mjs\" claude",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
