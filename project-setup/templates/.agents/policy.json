{
  "schemaVersion": 1,
  "enabled": true,
  "protectedPaths": [
    ".agents", ".github", ".githooks", "scripts/checks", "scripts/git", "scripts/skills", "scripts/agentic.mjs",
    "biome.json", ".fallowrc.json", "tsconfig.base.json", "package.json",
    "bun.lock", "bun.lockb", "package-lock.json", "pnpm-lock.yaml", "yarn.lock",
    "vitest.config.ts", "vitest.config.mts", "jest.config.js", "jest.config.ts", "playwright.config.ts"
  ],
  "gates": [
    {
      "id": "tests",
      "argv": {{AGENTIC_TEST_ARGV_JSON}},
      "timeoutMs": 600000,
      "discover": { "regex": {{AGENTIC_DISCOVER_REGEX_JSON}}, "min": 1 }
    }
  ],
  "requiredGates": ["tests"],
  "bootstrap": { "argv": {{AGENTIC_INSTALL_ARGV_JSON}}, "timeoutMs": 600000 },
  "baseline": "require-pass",
  "egress": {{#if AGENTIC_HOSTED_OK}}"hosted-allowed"{{else}}"local-only"{{/if}}
}
