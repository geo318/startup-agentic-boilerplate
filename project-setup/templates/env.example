# Every variable the project reads. Copy to .env and fill in values; never commit .env.
# Only the env module reads process.env — add new variables there and here in the same change.

NODE_ENV=development
{{#if HAS_DB}}

# Database — one canonical connection string
DATABASE_URL=
{{/if}}
{{#if HAS_AUTH}}

# Auth
AUTH_SECRET=
{{/if}}
{{#if HAS_AI}}

# AI providers (server-only)
{{/if}}
